# Copy to .env (never commit it) or export these in your shell.
# AI Hub public API base URL.
TOKENHUB_BASE_URL=https://tokenhub-api.belive.sg/api/v1
TOKENHUB_API_KEY=sk-tokenhub-…
# An exact model id from GET $TOKENHUB_BASE_URL/models. Tool calling needs a model whose
# supported_parameters include "tools".
TOKENHUB_MODEL=
